# ==============================================================================
# STREAMVAULT v2 — ARCHIVO DE ENTORNO PARA ORACLE CLOUD + MYSQL HEATWAVE + n8n
# ==============================================================================
# Copia este archivo a '.env' en tu servidor de Oracle Cloud ARM:
#   cp .env.oracle.example .env
# Luego completa los valores con tus credenciales seguras.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ORACLE CLOUD MYSQL HEATWAVE (ALWAYS FREE — 50 GB DE ALMACENAMIENTO)
# ------------------------------------------------------------------------------
# La IP privada de la base de datos dentro de tu Subred/VCN en Oracle Cloud
# (Ejemplo: 10.0.1.15)
MYSQL_HEATWAVE_HOST=10.0.1.15
MYSQL_HEATWAVE_PORT=3306
MYSQL_HEATWAVE_USER=streamadmin
MYSQL_HEATWAVE_PASSWORD=TuPasswordSuperSeguro_2026!
MYSQL_HEATWAVE_DATABASE_N8N=n8n_streamvault
MYSQL_HEATWAVE_DATABASE_EVO=evolution_streamvault

# ------------------------------------------------------------------------------
# 2. STREAMVAULT v2 CORE (CRM & REGLAS DE NEGOCIO)
# ------------------------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=GeneraUnPasswordRobustoAqui
SESSION_SECRET_KEY=GeneraUnTokenHexDe64CaracteresConOpensslRandHex32
PUBLIC_BASE_URL=https://tudominio.com
APP_BASE_URL=http://localhost:8000

# Credenciales de Telegram (Bot de Operaciones y Alertas)
TELEGRAM_BOT_TOKEN=123456789:AAXXXXXXXXXXXXXX_XXXXXXXXXXXX
TELEGRAM_ADMIN_CHAT_ID=123456789
TELEGRAM_CHANNEL_ID=-1001234567890

# ------------------------------------------------------------------------------
# 3. EVOLUTION API (WHATSAPP BUSINESS GATEWAY)
# ------------------------------------------------------------------------------
EVOLUTION_SERVER_URL=http://localhost:8081
EVOLUTION_API_KEY=GeneraUnaApiKeyHexSeguraParaEvolution
EVOLUTION_WEBHOOK_SECRET=GeneraUnSecretHmacParaFirmasDeWebhooks
EVOLUTION_INSTANCE_NAME=streamvault

# ------------------------------------------------------------------------------
# 4. n8n AUTOMATION ENGINE (BUFFER ANTI-BAN & WORKFLOWS)
# ------------------------------------------------------------------------------
N8N_USER=admin
N8N_PASSWORD=PasswordSeguroParaAccederAlPanelN8n
N8N_PUBLIC_WEBHOOK_URL=https://n8n.tudominio.com/
